# Copy to .env (never commit). Phase 0 needs JWT_SECRET.
# GEMINI/GROQ are fail-fast required by 01 even though unused until Phases 1–2.

JWT_SECRET=replace-with-at-least-32-random-bytes-please-change
# Optional rotation list (JSON). First entry is the signing key.
# JWT_SECRETS=["new-secret-at-least-32-bytes-long-ok","old-secret-at-least-32-bytes-long"]

GEMINI_API_KEY=replace-me
GROQ_API_KEY=replace-me
RESTORE_TOKEN=replace-with-32-bytes-random

# Pinned models (01 §4.8). Changing either is a migration + cache flush + full-40 re-eval.
# Pack said text-embedding-004; Google shut it down 2026-01-14 → gemini-embedding-001 (768-d via outputDimensionality).
EMBED_MODEL=gemini-embedding-001@PINNED
# Pack said gemini-2.5-flash; Google retired it for new keys → gemini-3.6-flash (still @PINNED).
GEN_MODEL=gemini-3.6-flash@PINNED

# Paths (Compose mounts these as three separate volumes)
DATABASE_URL=sqlite+aiosqlite:///./data/sqlite/app.db
CHROMA_PATH=./data/chroma
BACKUPS_PATH=./data/backups

APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Web OAuth client ID (same value Flutter gets via --dart-define=GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Outgoing mail: free Gmail via Apps Script (HTTPS — works when ISP blocks port 587).
# See SMTP-SETUP.md. URL + secret must match the deployed script.
GMAIL_WEBAPP_URL=
GMAIL_WEBAPP_SECRET=
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
